# URL-ul public al site-ului (pentru SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.puiimei.ro

# Administratorul principal: intră pe /cont/autentificare cu ADMIN_USER (în câmpul Email) și ADMIN_PASSWORD.
# Din /admin/utilizatori poate crea apoi conturi pentru gospodari, investitori și alți administratori.
ADMIN_USER=
ADMIN_PASSWORD=

# Cheia de semnare a sesiunilor (un text lung, aleatoriu; schimbarea ei deconectează pe toată lumea)
SESSION_SECRET=

# Director pentru stocarea în fișiere când nu există bază de date (implicit ./.data, /tmp pe Vercel)
# PUII_MEI_DATA_DIR=

# Baza de date PostgreSQL (recomandat în producție; ex. Neon prin Vercel → Storage)
# DATABASE_URL=postgresql://user:parola@host:5432/puiimei

# Mod „în construcție”: 1 = vizitatorii văd doar pagina /in-constructie
# MAINTENANCE_MODE=1
# Cheie secretă pentru a vedea site-ul complet: deschide /acces?cheie=<PREVIEW_KEY>
# PREVIEW_KEY=

# Stocarea fișierelor (poze și documente) în afara bazei de date: orice stocare S3 compatibilă, bucket PRIVAT
# (ex. Cloudflare R2: endpoint https://<id-cont>.r2.cloudflarestorage.com, regiunea „auto”). Fără aceste variabile,
# fișierele se salvează în baza de date. Fișierele vechi se mută din Admin → Documente → „Stocarea fișierelor”.
# FILES_S3_ENDPOINT=
# FILES_S3_BUCKET=
# FILES_S3_REGION=auto
# FILES_S3_ACCESS_KEY_ID=
# FILES_S3_SECRET_ACCESS_KEY=

# Cheia jobului zilnic (Vercel Cron → /api/cron/alerte-documente: alertele de expirare a documentelor).
# Un text aleatoriu de minimum 16 caractere; fără ea, jobul refuză orice apel (alertele se pot trimite din Admin → Documente).
# CRON_SECRET=
