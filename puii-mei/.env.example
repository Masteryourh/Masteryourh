# URL-ul public al site-ului (pentru SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://puiimei.ro

# Panoul /admin este activ doar dacă ambele variabile sunt setate (HTTP Basic Auth)
ADMIN_USER=
ADMIN_PASSWORD=

# Director pentru stocarea locală a precomenzilor și mesajelor (implicit ./.data)
# PUII_MEI_DATA_DIR=

# Viitor: baza de date (vezi prisma/schema.prisma)
# DATABASE_URL=postgresql://user:parola@localhost:5432/puiimei
