# URL-ul public al site-ului (pentru SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.puiimei.ro

# Panoul /admin este activ doar dacă ambele variabile sunt setate (HTTP Basic Auth)
ADMIN_USER=
ADMIN_PASSWORD=

# Director pentru stocarea în fișiere când nu există bază de date (implicit ./.data, /tmp pe Vercel)
# PUII_MEI_DATA_DIR=

# Baza de date PostgreSQL (recomandat în producție; ex. Neon prin Vercel → Storage)
# DATABASE_URL=postgresql://user:parola@host:5432/puiimei

# Mod „în construcție”: 1 = vizitatorii văd doar pagina /in-constructie
# MAINTENANCE_MODE=1
# Cheie secretă pentru a vedea site-ul complet: deschide /acces?cheie=<PREVIEW_KEY>
# PREVIEW_KEY=

# Emailuri automate (ex. linkul de confirmare a primirii) prin Resend – https://resend.com
# RESEND_API_KEY=
# EMAIL_FROM=Puii mei <comenzi@puiimei.ro>
