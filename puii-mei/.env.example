# URL-ul public al site-ului (pentru SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://puiimei.ro

# Panoul /admin este activ doar dacă ambele variabile sunt setate (HTTP Basic Auth)
ADMIN_USER=
ADMIN_PASSWORD=

# Director pentru stocarea în fișiere când nu există bază de date (implicit ./.data, /tmp pe Vercel)
# PUII_MEI_DATA_DIR=

# Baza de date PostgreSQL (recomandat în producție; ex. Neon prin Vercel → Storage)
# DATABASE_URL=postgresql://user:parola@host:5432/puiimei
